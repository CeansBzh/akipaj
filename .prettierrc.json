{
    "plugins": [
        "@shufo/prettier-plugin-blade",
        "prettier-plugin-tailwindcss"
    ],
    "overrides": [
        {
            "files": [
                "*.blade.php"
            ],
            "options": {
                "tabWidth": 4,
                "parser": "blade"
            }
        }
    ],
    "sortTailwindcssClasses": true,
    "singleQuote": true,
    "printWidth": 120
}
